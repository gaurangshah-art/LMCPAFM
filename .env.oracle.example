# Copy to .env on your Oracle Cloud VM and edit values.
# Staging example: lmcpafm-staging.lmcp.ac.in

# --- Database (PostgreSQL via compose.postgres.yaml) ---
POSTGRES_DB=lmcpafm
POSTGRES_USER=lmcpafm
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lmcpafm:change-me-strong-password@postgres:5432/lmcpafm

# --- Auth ---
JWT_SECRET_KEY=change-me-long-random-secret
JWT_EXPIRE_MINUTES=480

# --- Public URLs (must match your domain; rebuild frontend after changes) ---
# If nginx serves API at https://your-domain/api/ use that base URL:
VITE_API_BASE_URL=https://lmcpafm-staging.lmcp.ac.in/api
CORS_ALLOW_ORIGINS=https://lmcpafm-staging.lmcp.ac.in

# --- Persistent data on the VM host ---
LMCPAFM_DATA_DIR=/opt/lmcpafm/data

# --- Ports bound to localhost (must match deploy/nginx/lmcpafm-staging.conf) ---
PORT=8001
FRONTEND_PROD_PORT=8081

# --- Institution ---
LMCP_INSTITUTIONAL_EMAIL_DOMAINS=lmcp.ac.in
LMCP_ESTABLISHMENT_NAME=L. M. College of Pharmacy, Ahmedabad
LMCP_COLLEGE_DISPLAY_NAME=L. M. College of Pharmacy, Ahmedabad
LMCP_ESTABLISHMENT_ADDRESS=L.M. College of Pharmacy, Navrangpura, Ahmedabad - 380009, Gujarat, India
LMCP_CPCSEA_REGISTRATION_NUMBER=228/PO/ReBi/S/2000/CPCSEA
LMCP_CPCSEA_REGISTRATION_DATE=16th June, 2000
LMCP_ANIMAL_HOUSING_LOCATION=Institutional Animal House, L.M. College of Pharmacy, Ahmedabad - 380009
FORMB_ATTACHMENT_DIR=/data/form_b_attachments

# --- IAEC email (required for meeting invitations) ---
IAEC_SMTP_HOST=smtp.gmail.com
IAEC_SMTP_PORT=587
IAEC_SMTP_USERNAME=iaec@lmcp.ac.in
IAEC_SMTP_PASSWORD=replace-with-app-password
IAEC_SMTP_USE_TLS=true
IAEC_SENDER_EMAIL=iaec@lmcp.ac.in
IAEC_SENDER_NAME=Member Secretary IAEC
IAEC_PPT_GOOGLE_FORM_URL=
IAEC_SUPPORT_CONTACT=iaec@lmcp.ac.in
