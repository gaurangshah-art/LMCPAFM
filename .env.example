# Backend application settings
# Container-friendly default; override for PostgreSQL or local non-container runs.
DATABASE_URL=sqlite:////data/LMCPAFM.db
JWT_SECRET_KEY=replace-with-a-real-secret
JWT_EXPIRE_MINUTES=60
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
PORT=8000
FRONTEND_PORT=5173
FRONTEND_PROD_PORT=8080
VITE_API_BASE_URL=http://localhost:8000

# PostgreSQL override values for compose.postgres.yaml
POSTGRES_DB=lmcpafm
POSTGRES_USER=lmcpafm
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
IAEC_SMTP_HOST=smtp.gmail.com
IAEC_SMTP_PORT=587
IAEC_SMTP_USERNAME=your_smtp_username
IAEC_SMTP_PASSWORD=your_smtp_password
IAEC_SMTP_USE_TLS=true
IAEC_SENDER_EMAIL=iaec@example.edu
IAEC_SENDER_NAME=IAEC Office
IAEC_PPT_GOOGLE_FORM_URL=https://forms.gle/your-form-id
IAEC_SUPPORT_CONTACT=IAEC Office