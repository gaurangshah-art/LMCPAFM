# Backend application settings
# Docker/compose default (volume mounted at /data):
# DATABASE_URL=sqlite:////data/LMCPAFM.db
# Local Windows/macOS/Linux dev without Docker:
DATABASE_URL=sqlite:///database/LMCPAFM.db
JWT_SECRET_KEY=replace-with-a-real-secret
JWT_EXPIRE_MINUTES=240
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
PORT=8000
FRONTEND_PORT=5173
FRONTEND_PROD_PORT=8080
VITE_API_BASE_URL=http://localhost:8000
VITE_LMCP_INSTITUTIONAL_EMAIL_DOMAINS=lmcp.ac.in
# Optional custom logo URL for the frontend (defaults to /lmcp-logo.png official crest)
# VITE_LMCP_LOGO_URL=/lmcp-logo.png
LMCP_INSTITUTIONAL_EMAIL_DOMAINS=lmcp.ac.in
LMCP_ESTABLISHMENT_NAME=L. M. College of Pharmacy, Ahmedabad
LMCP_COLLEGE_DISPLAY_NAME=L. M. College of Pharmacy, Ahmedabad
# Optional custom logo path (defaults to static/branding/lmcp-logo.png — official LMCP crest)
# LMCP_LOGO_PATH=static/branding/lmcp-logo.png
LMCP_ESTABLISHMENT_ADDRESS=L.M. College of Pharmacy, Navrangpura, Ahmedabad - 380009, Gujarat, India
LMCP_CPCSEA_REGISTRATION_NUMBER=228/PO/ReBi/S/2000/CPCSEA
LMCP_CPCSEA_REGISTRATION_DATE=16th June, 2000
LMCP_ANIMAL_HOUSING_LOCATION=Institutional Animal House, L.M. College of Pharmacy, Ahmedabad - 380009
FORMB_ATTACHMENT_DIR=data/form_b_attachments

# IAEC Form B meeting invitation email (required for "Send invitation" in IAEC dashboard)
# Use your institutional SMTP relay or provider (Gmail/Office365 need app passwords).
IAEC_SMTP_HOST=smtp.gmail.com
IAEC_SMTP_PORT=587
IAEC_SMTP_USERNAME=iaec@lmcp.ac.in
IAEC_SMTP_PASSWORD=replace-with-app-password-or-smtp-secret
IAEC_SMTP_USE_TLS=true
IAEC_SENDER_EMAIL=iaec@lmcp.ac.in
IAEC_SENDER_NAME=Member Secretary IAEC
IAEC_PPT_GOOGLE_FORM_URL=https://forms.gle/Xn35w2wyhaKK8PXL7
IAEC_SUPPORT_CONTACT=iaec@lmcp.ac.in

# PostgreSQL override values for compose.postgres.yaml
POSTGRES_DB=lmcpafm
POSTGRES_USER=lmcpafm
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432